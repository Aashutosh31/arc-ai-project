# ARC-AI Server Environment Variables Template

# Server Port Configuration
PORT=5000

# CORS Allowed Origins (Comma-separated list)
FRONTEND_URL=http://localhost:5173

# Database Connection (MongoDB Atlas URI)
MONGO_URI=your_mongodb_connection_string
# DATABASE_URL=your_mongodb_connection_string_fallback

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# Mistral AI configuration
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_MODEL=mistral-small-latest
# MISTRAL_LIGHT_MODEL=your_custom_mistral_lightweight_model
# MISTRAL_VISION_MODEL=pixtral-12b-2409

# Gemini AI configuration
GEMINI_API_KEY=your_gemini_api_key
# Optional custom models
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_REASONING_MODEL=gemini-2.5-flash
# GEMINI_VISION_MODEL=gemini-2.5-flash

# Groq configuration (OpenAI-compatible endpoint https://api.groq.com/openai/v1)
GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=openai/gpt-oss-120b

# Optional LLM Router & Streaming configuration
# LLM_PRIMARY_PROVIDER=auto  # Options: auto, groq, gemini, mistral
# LLM_FALLBACK_PROVIDER=gemini
# LLM_FORCE_PROVIDER=
# LLM_STREAM_CHUNK_DELAY_MS=0  # Default 0 (no artificial delay). Set e.g. 20 to simulate typing.

# Optional server text-to-speech (browser-agnostic voice output)
# TTS_PROVIDER=browser  # Options: browser (default, device voices), gemini (server-generated audio)
# TTS_MODEL=gemini-2.5-flash-preview-tts
# TTS_VOICE=Kore

# Pinecone Vector RAG configuration
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=arc-brain

# Google Apps Script Email Webhook URI
GOOGLE_EMAIL_WEBHOOK=your_google_apps_script_webhook_url

# Google OAuth App Credentials (for Sign-In & Calendar integrations)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback

# CRITICAL: Google OAuth Token Database Encryption Key (Required, 32+ char hex/random string)
GOOGLE_TOKEN_ENCRYPTION_KEY=your_secure_32_byte_token_encryption_key

# Optional Puppeteer / Chromium paths (in case custom executable is needed)
# CHROMIUM_PATH=
# CHROME_BIN=
# PUPPETEER_EXECUTABLE_PATH=

# Optional WhatsApp Client Configurations
# WHATSAPP_IDLE_TIMEOUT_MS=300000
