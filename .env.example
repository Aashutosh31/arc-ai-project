# ARC-AI Server Environment Variables Template

# Server Port Configuration
PORT=5000

# CORS Allowed Origins (Comma-separated list)
FRONTEND_URL=http://localhost:5173

# Database Connection (MongoDB Atlas URI)
MONGO_URI=your_mongodb_connection_string
# DATABASE_URL=your_mongodb_connection_string_fallback

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# Gemini AI configuration (primary voice provider: STT + TTS)
GEMINI_API_KEY=your_gemini_api_key
# Primary STT model
GEMINI_STT_MODEL=gemini-3.5-transcribe-live
# Primary TTS model
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Gemini TTS voice (Kore by default; replaceable without architecture changes)
GEMINI_TTS_VOICE=Kore
# Optional custom models
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_REASONING_MODEL=gemini-2.5-flash
# GEMINI_VISION_MODEL=gemini-2.5-flash
# Optional embedding model/width (defaults preserve the 1024-dim index space)
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_EMBEDDING_DIMENSIONS=1024

# Groq configuration (OpenAI-compatible endpoint https://api.groq.com/openai/v1)
# Groq is the current primary LLM provider for text/tools. gpt-oss-120b is text-only.
GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=openai/gpt-oss-120b

# Optional LLM Router & Streaming configuration
# LLM_PRIMARY_PROVIDER=auto  # Options: auto, groq, gemini. 'auto' routes multimodal requests to Gemini.
# LLM_FALLBACK_PROVIDER=     # Read by the router; the fallback cascade currently derives from provider availability + capability filtering
# LLM_FORCE_PROVIDER=        # Force a single provider
# LLM_STREAM_CHUNK_DELAY_MS=0  # Default 0 (no artificial delay). Set e.g. 20 to simulate typing.

# Optional server text-to-speech (browser-agnostic voice output)
# TTS_PROVIDER=browser  # Options: browser (device voices), sarvam (fallback), gemini (default)
# TTS_VOICE=Kore           # Gemini TTS voice; ignored by sarvam/browser modes
TTS_PROVIDER=gemini       # Primary voice provider: gemini | sarvam | browser
# TTS_MODEL=gemini-2.5-flash-preview-tts  # Ignored when TTS_PROVIDER=gemini; uses GEMINI_TTS_MODEL
# TTS_VOICE=Kore  # Ignored when TTS_PROVIDER!=gemini

# Sarvam AI optional fallback voice (primary is Gemini; Sarvam remains fallback only)
# STT_PROVIDER=sarvam  # Options: sarvam (fallback when SARVAM_API_KEY set), gemini (default), mock (dev)
# TTS_PROVIDER=sarvam  # Options: sarvam (fallback only), browser, gemini (default)
# Sarvam is intentionally NOT the primary voice provider; it is kept as a fallback.
# Set SARVAM_API_KEY to enable Sarvam fallback only.
SARVAM_API_KEY=your_sarvam_api_key
# Optional overrides (defaults shown — sarvam model IDs should NOT reference Gemini model names)
# SARVAM_STT_MODEL=saaras:v3-realtime   # Sarvam STT model; NOT used when gemini is primary
# SARVAM_STT_LANGUAGE=auto   # BCP-47, e.g. hi-IN; 'auto' enables auto-detection
# SARVAM_STT_STREAM_TYPE=fast
# SARVAM_STT_ENDPOINTING=vad
# SARVAM_STT_SILENCE_MS=350
# SARVAM_STT_MIN_SPEECH_MS=250
# SARVAM_TTS_MODEL=bulbul:v3   # Sarvam TTS model; fallback only, NOT used as primary
# SARVAM_TTS_SPEAKER=shubh
# SARVAM_TTS_LANGUAGE=en-IN  # TTS fallback language; unsupported codes map to en-IN
# SARVAM_TTS_MIN_BUFFER_SIZE=30   # conversational latency lever (documented range 30-200)
# SARVAM_TTS_MAX_CHUNK_LENGTH=150 # Sarvam-side synthesis unit (documented range 50-500)
# SARVAM_STT_ENDPOINT=     # optional override wss:// URL for the realtime STT endpoint
# SARVAM_TTS_ENDPOINT=     # optional override wss:// URL for the streaming TTS endpoint

# Pinecone Vector RAG configuration
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=arc-brain

# Google Apps Script Email Webhook URI
GOOGLE_EMAIL_WEBHOOK=your_google_apps_script_webhook_url

# Google OAuth App Credentials (for Sign-In & Calendar integrations)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback

# CRITICAL: Google OAuth Token Database Encryption Key (Required, 32+ char hex/random string)
GOOGLE_TOKEN_ENCRYPTION_KEY=your_secure_32_byte_token_encryption_key

# MCP OAuth (Phase 3) — remote MCP servers with OAuth authorization.
# MCP_TOKEN_ENCRYPTION_KEY encrypts per-user MCP OAuth tokens at rest
# (AES-256-GCM). Falls back to GOOGLE_TOKEN_ENCRYPTION_KEY when unset; OAuth
# endpoints fail closed until one of them is configured. Non-OAuth MCP is
# unaffected.
# MCP_TOKEN_ENCRYPTION_KEY=your_secure_32_byte_mcp_token_encryption_key
# Public backend base URL used to build the OAuth callback URL
# (must be reachable by the user's browser). Defaults to http://localhost:{PORT}.
# PUBLIC_BACKEND_URL=https://api.example.com
# Optional Client ID Metadata Document URL: when set AND the authorization
# server advertises client_id_metadata_document_supported, the MCP SDK prefers
# CIMD; otherwise it uses Dynamic Client Registration. Must be https.
# MCP_OAUTH_CLIENT_METADATA_URL=https://app.example.com/cimd/arc-mcp-client.json

# Optional Puppeteer / Chromium paths (in case custom executable is needed)
# CHROMIUM_PATH=
# CHROME_BIN=
# PUPPETEER_EXECUTABLE_PATH=

# Optional WhatsApp Client Configurations
# WHATSAPP_IDLE_TIMEOUT_MS=300000
