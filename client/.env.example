# ARC-AI Client Environment Variables Template (Vite)

# Base URL for REST calls — DEV ONLY.
#   dev  (default) -> http://localhost:5000 (direct, cross-origin — CORS + SameSite=Lax)
#   prod           -> IGNORED. Production builds always use an empty API base so
#                     every REST call goes to the SAME ORIGIN under /api/**,
#                     which client/vercel.json rewrites to the backend host.
#                     This makes the auth cookie first-party and unblocked by
#                     Safari/Firefox's third-party cookie blocking.
# VITE_API_URL=http://localhost:5000

# Direct origin for the Socket.IO connection (WebSocket upgrades are not
# forwarded by the /api proxy, so the socket connects straight to the API host
# and authenticates with a one-time ticket fetched through the same-origin
# proxy — see client/src/config.js for the full rationale).
# Defaults to the production backend if unset in a production build; set this
# if your API host differs.
# VITE_SOCKET_URL=https://arc-ai-backend.onrender.com
